{
  "version": 2,
  "name": "google-photos-retrieval-mvp",
  "builds": [
    { "src": "api/*.js", "use": "@vercel/node" },
    { "src": "public/**/*", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/scenarios", "dest": "/api/scenarios.js" },
    { "src": "/api/search", "dest": "/api/search.js" },
    { "src": "/api/expand", "dest": "/api/expand.js" },
    { "src": "/(.*)", "dest": "/public/$1" }
  ]
}
